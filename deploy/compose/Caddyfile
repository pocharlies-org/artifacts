# Caddyfile — replicates the Traefik IngressRoute rules of the Helm chart for the local
# stack (see helm/artifacts/templates/artifacts-routes.yaml). Host is 127.0.0.1.
#   1. writes (non-GET/HEAD)       -> gate (405 before any login)
#   2. anonymous pub/ GET/HEAD     -> MinIO (no .acl.json, no trailing-slash listings)
#   3. artifact GET/HEAD           -> forwardAuth to the gate's decision listener, then MinIO
#                                     with the gate's SigV4 headers (no anonymous read off pub/)
#   4. /_gate/* (not auth/healthz) -> gate
#   5. /oauth2/ browser endpoints  -> oauth2-proxy, ALLOW-LIST only: sign_in, start, callback,
#                                     sign_out, static/<file>; any other /oauth2 path -> 404
#   6. plugin routes               -> plugin services (env ARTIFACTS_CADDY_PLUGINS, see below)
{
	admin off
}

# Plugin route (docs/plugins.md §2), the compose equivalent of the chart's plugins-routes:
# `import plugin <pathPrefix> <service:port>` passes the whole prefix through (WebSockets
# included) and drops any client-supplied identity headers; the plugin asks the gate.
(plugin) {
	handle {args[0]}* {
		reverse_proxy {args[1]} {
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Email
			header_up -X-Auth-Request-Preferred-Username
			header_up -X-Auth-Request-Groups
		}
	}
}

:80 {
	# Plugins: one `import plugin /_<name>/ <service>:<port>` line per plugin, newline
	# separated, from the caddy service's ARTIFACTS_CADDY_PLUGINS (empty = no plugins).
	# Caddy substitutes {$VAR} before parsing, so the lines become directives here. A plugin
	# prefix must start with /_, end with /, and never be /_gate/, /_plugins/ or /oauth2/.
	{$ARTIFACTS_CADDY_PLUGINS}

	@write {
		path /artifacts/*
		not method GET HEAD
	}
	handle @write {
		reverse_proxy gate:8080
	}

	@pub path /artifacts/pub/*
	handle @pub {
		# backticks: in a Caddyfile single quotes are literal characters, so a '...' regex
		# never matched and pub/<run>/.acl.json was served anonymously.
		@pubbad path_regexp bad `\.acl\.json$|/$`
		respond @pubbad 404
		header Content-Security-Policy "sandbox allow-scripts"
		reverse_proxy minio:9000 {
			header_up -Authorization
			header_up -Cookie
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Email
			header_up -X-Auth-Request-Preferred-Username
			header_up -X-Auth-Request-Groups
		}
	}

	@gated path /artifacts/*
	handle @gated {
		# On allow the gate answers with SigV4 headers for this exact read (the bucket has
		# no anonymous policy outside pub/): copy them onto the upstream request, replacing
		# whatever the visitor sent (e.g. a Bearer id_token).
		forward_auth gate:8081 {
			uri /_gate/auth
			copy_headers Authorization X-Amz-Date X-Amz-Content-Sha256
			@needsauth status 401
			handle_response @needsauth {
				redir "http://127.0.0.1:8080/oauth2/sign_in?rd={uri}" 302
			}
		}
		header Content-Security-Policy "sandbox allow-scripts"
		reverse_proxy minio:9000 {
			header_up -Cookie
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Email
			header_up -X-Auth-Request-Preferred-Username
			header_up -X-Auth-Request-Groups
		}
	}

	@gateapi path /_gate/* !/_gate/auth !/_gate/healthz
	handle @gateapi {
		reverse_proxy gate:8080
	}

	# oauth2-proxy: ALLOW-LIST of its browser endpoints. It runs with --upstream=static://202
	# and --set-authorization-header, so EVERY path its own router does not claim (/auth, but
	# also /zzz, /, /ping, /userinfo, /sign_inX, /SIGN_IN...) is authenticated and answered
	# 202 + `Authorization: Bearer <id_token>`. Its router (gorilla/mux, UseEncodedPath) is
	# case-sensitive and matches the RAW, still-encoded path, so a spelling Caddy decodes or
	# cleans onto an allowed endpoint (/oauth2/%73ign_in, /oauth2/x/../sign_in) would still
	# miss it there and fall to that 202. Two conditions, both case-sensitive:
	#   path_regexp  the decoded, cleaned path Caddy sees is exactly an allowed endpoint;
	#   vars_regexp  the request target AS SENT (orig_uri: no '%', no '//', no dot segment,
	#                same case) is that same endpoint plus an optional query string.
	# So oauth2-proxy only ever receives /oauth2/<endpoint>[?query] verbatim.
	# static/<file>: the proxy's own CSS and fonts (error pages); file names only, no listing.
	@oauth2browser {
		path_regexp `^/oauth2/(sign_in|start|callback|sign_out|static/([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+)$`
		vars_regexp {http.request.orig_uri} `^/oauth2/(sign_in|start|callback|sign_out|static/([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+)([?].*)?$`
	}
	handle @oauth2browser {
		reverse_proxy oauth2-proxy:4180
	}

	# Everything else under /oauth2 (any case, any encoding, /auth included: the gate's
	# in-network identity check) is never routed to oauth2-proxy.
	@oauth2other path_regexp (?i)^/+oauth2
	handle @oauth2other {
		respond 404
	}

	respond 404
}
